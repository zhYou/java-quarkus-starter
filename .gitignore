# Gradle 缓存与构建产物（包括 build-logic）
.gradle/
**/build/

# 不再维护的版本锁与依赖校验生成文件
gradle.lockfile
settings-gradle.lockfile
/mise.lock
/gradle/verification-metadata.xml

# 本地环境、凭据与备份；示例配置需要提交
.local/
.env
.env.*
!.env.example

# IDE 项目状态
.idea/
*.iml

# Git 隔离工作区
/.worktrees/

# 智能体工具的本地工作记录与缓存
.superpowers/
.serena/cache/
.serena/memories/

# Python 工具缓存（可选 Serena 等工具仍可能生成）
__pycache__/
*.pyc
