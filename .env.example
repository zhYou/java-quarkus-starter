# Copy values to your environment for an external development PostgreSQL.
# Local compose credentials are generated by scripts/dev.py under ignored .local/.
APP_DB_MODE=single
APP_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/starter
APP_DB_USERNAME=app_runtime
APP_DB_PASSWORD=REPLACE_ME
APP_DB_MIGRATION_USERNAME=app_migration
APP_DB_MIGRATION_PASSWORD=REPLACE_ME
